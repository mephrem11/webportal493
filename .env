# ─────────────────────────────────────────────────────────────
#  Goods Recycling Portal — Email Configuration
# ─────────────────────────────────────────────────────────────
#
#  OPTION A  ·  EmailJS (recommended — free, no backend needed)
#  1. Create a free account at https://www.emailjs.com
#  2. Add an Email Service (Gmail / Outlook) → copy the Service ID
#  3. Create an Email Template that uses these variables:
#       {{to_email}}  {{subject}}  {{message}}  {{from_name}}
#     → copy the Template ID
#  4. Go to Account → API Keys → copy your Public Key
#  5. Paste the three values below, then restart the dev server
#
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ─────────────────────────────────────────────────────────────
#  OPTION B  ·  Custom backend / Supabase Edge Function endpoint
#  Set the full HTTPS URL of your email endpoint.
#  The endpoint receives JSON: { to, from, subject, message }
#  Optional: add a bearer token if your endpoint requires it.
#
VITE_EMAIL_ENDPOINT=http://localhost:3001/send-email
VITE_EMAIL_ENDPOINT_AUTH=

# ─────────────────────────────────────────────────────────────
#  SMTP EMAIL — works with ANY email provider (Gmail, Outlook, Yahoo, iCloud…)
#  Fill in the credentials for whichever email account you want to send from.
#
#  Common SMTP settings by provider:
#
#  Gmail        host: smtp.gmail.com        port: 587
#               Use an App Password (not your real password):
#               → https://myaccount.google.com/apppasswords
#               (requires 2-Step Verification enabled)
#
#  Outlook/Hotmail  host: smtp.office365.com   port: 587
#               Use your normal Outlook password
#
#  Yahoo        host: smtp.mail.yahoo.com    port: 587
#               Use an App Password from Yahoo Account Security
#
#  iCloud       host: smtp.mail.me.com       port: 587
#               Use an App-Specific Password from appleid.apple.com
#
#  Custom/other  set SMTP_HOST to your mail server hostname
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password-here
SMTP_FROM=your@email.com

# ─────────────────────────────────────────────────────────────
#  SMS Configuration
#  Frontend SMS endpoint (local server route)
VITE_SMS_ENDPOINT=http://localhost:3001/send-sms
VITE_SMS_ENDPOINT_AUTH=

#  Twilio credentials for real SMS delivery (server-side)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
