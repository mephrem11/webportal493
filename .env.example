# Option 1: custom backend/edge email endpoint
# Example: https://<project>.supabase.co/functions/v1/send-email
VITE_EMAIL_ENDPOINT=
# Optional bearer token for your endpoint
VITE_EMAIL_ENDPOINT_AUTH=

# Option 2: EmailJS direct browser integration
# Create EmailJS service + template and set these values
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
