# Option 1: custom backend/edge email endpoint
# Example: https://<project>.supabase.co/functions/v1/send-email
VITE_EMAIL_ENDPOINT=
# Optional bearer token for your endpoint
VITE_EMAIL_ENDPOINT_AUTH=

# Option 2: EmailJS direct browser integration
# Create EmailJS service + template and set these values
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional SMS endpoint for real mobile text delivery
# Endpoint payload: { to, message }
VITE_SMS_ENDPOINT=http://localhost:3001/send-sms
# Optional bearer token
VITE_SMS_ENDPOINT_AUTH=

# Server-side SMTP (for /send-email route)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Server-side Twilio (for /send-sms route)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
